datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(uuid())
  name      String?
  email     String?   @unique
  chatLogs  ChatLog[]
  createdAt DateTime  @default(now())
  chats     Chat[]

  @@map("users")
}

/// AI人格（ペルソナ）の定義。ユーザーからは独立したエンティティ。
model Persona {
  id               String            @id @default(uuid())
  name             String            @default("Reflecta")
  statuses         PersonaStatus[]
  chatLogs         ChatLog[]
  reflectionEvents ReflectionEvent[]
  createdAt        DateTime          @default(now())
  chats            Chat[]

  @@map("personas")
}

/// ペルソナの動的なステータス。時系列で保存される。
model PersonaStatus {
  id        Int      @id @default(autoincrement())
  personaId String
  persona   Persona  @relation(fields: [personaId], references: [id])
  height    Float    @default(160.0)
  weight    Float    @default(50.0)
  health    Int      @default(100)
  mood      Int      @default(50)
  trust     Int      @default(50)
  updatedAt DateTime @updatedAt

  @@map("persona_statuses")
}

// チャット。ユーザーとペルソナの対話。チャット履歴の親。
model Chat {
  id        String    @id @default(uuid())
  title     String    @default("New Chat")
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  personaId String?
  persona   Persona?  @relation(fields: [personaId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  chatLogs  ChatLog[]

  @@map("chats")
}

/// 会話履歴。特定のユーザーと特定のペルソナの対話を記録。
model ChatLog {
  id        String   @id @default(uuid())
  chatId    String?
  chat      Chat?    @relation(fields: [chatId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  personaId String?
  persona   Persona? @relation(fields: [personaId], references: [id])
  role      String // "user" or "assistant"
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@map("chat_logs")
}

/// 内省処理（リフレクション）の実行記録
model ReflectionEvent {
  id              String   @id @default(uuid())
  personaId       String
  persona         Persona  @relation(fields: [personaId], references: [id])
  thought         String   @db.Text
  statusUpdate    Json // 推論されたステータスの増減値
  permanentMemory String?  @db.Text
  createdAt       DateTime @default(now())

  @@map("reflection_events")
}

/// その他の一般的なイベントログ
model EventLog {
  id        String   @id @default(uuid())
  type      String // "physical", "emotional", "memory"
  content   String   @db.Text
  value     Float?
  createdAt DateTime @default(now())

  @@map("event_logs")
}
