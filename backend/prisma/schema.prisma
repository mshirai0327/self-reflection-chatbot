datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// ユーザー情報。AIとの対話者。
model User {
  id        String    @id @default(uuid())
  /// ユーザーの表示名
  name      String?
  /// ログインに使用するメールアドレス
  email     String?   @unique
  /// このユーザーが関わった会話ログ
  chatLogs  ChatLog[]
  /// アカウント作成日時
  createdAt DateTime  @default(now())
  /// このユーザーが開始したチャットセッション
  chats     Chat[]

  @@map("users")
}

/// AI人格（ペルソナ）の定義。ユーザーからは独立した個体として管理。
model Persona {
  id   String @id @default(uuid())
  /// ペルソナの名前（例: Reflecta）
  name String @default("Reflecta")

  /// 最新ステータスのポインタ。常に最新の状態へ単一リレーションでアクセス可能。
  status PersonaStatus?

  /// Lv1-1: 完全不変・定量可能。生物学的・遺伝的な基本情報。
  quantityUnchange     QuantityUnchangeStatus?
  /// Lv1-2: 完全不変・定量困難。深層心理や根源的な性格特性。
  semiquantityUnchange SemiquantityUnchangeStatus?

  /// ペルソナによる発言を含む会話ログ
  chatLogs         ChatLog[]
  /// ペルソナが行った内省イベントの記録
  reflectionEvents ReflectionEvent[]
  /// ペルソナの生成日時
  createdAt        DateTime          @default(now())
  /// ペルソナが参加しているチャットセッション
  chats            Chat[]

  @@map("personas")
}

/// ステータスのハブテーブル。ある時点での全生体・心理データのスナップショットを束ねる。
/// NOTE: 1:1でPersonaと紐づき、ここがHubとなる。履歴は配下のテーブルが持つ。
model PersonaStatus {
  statusId  String   @id @default(uuid()) @map("status_id")
  /// Hubの作成日時
  createdAt DateTime @default(now()) @map("created_at")

  /// 所有者であるペルソナのID
  personaId String  @unique @map("persona_id")
  persona   Persona @relation(fields: [personaId], references: [id])

  /// Lv2: 成長記録へのリレーション (1:N - History)
  quantityIrreversible   QuantityIrreversibleStatus[]
  /// Lv3-1: バイタルデータへのリレーション (1:N - History)
  quantityReversible     QuantityReversibleStatus[]
  /// Lv3-2: 感情・健康パラメータへのリレーション (1:N - History)
  semiquantityReversible SemiquantityReversibleStatus[]

  @@map("persona_statuses")
}

/// Lv1-1: 完全不変・定量可能。生物学的・遺伝的な基本情報。
model QuantityUnchangeStatus {
  id String @id @default(uuid())

  personaId String  @unique @map("persona_id")
  persona   Persona @relation(fields: [personaId], references: [id])

  /// 生年月日。年齢の算出に使用。
  birthDate       DateTime? @map("birth_date")
  /// 性別。ホルモンバランスや対話スタイルの基礎。
  gender          String?
  /// 血液型。
  bloodType       String?   @map("blood_type")
  /// クロノタイプ。朝型・夜型などの活動周期。
  chronotype      String?
  /// 苦味感受性。味覚の鋭敏さなどの身体的特徴。
  bitternessSense Int?      @map("bitterness_sense")
  /// 知能。論理的思考能力のベースライン。
  intelligence    Int?

  @@map("quantity_unchange_statuses")
}

/// Lv1-2: 完全不変・定量困難。深層心理や根源的な性格特性。
model SemiquantityUnchangeStatus {
  id String @id @default(uuid())

  personaId String  @unique @map("persona_id")
  persona   Persona @relation(fields: [personaId], references: [id])

  /// 倫理観。行動選択の基準（0-100）。
  ethics         Int @default(50)
  /// 情熱。物事への追求心やエネルギー（0-100）。
  passion        Int @default(50)
  /// 好奇心。未知のものへの関心（0-100）。
  curiosity      Int @default(50)
  /// 攻撃性。対立時の反応傾向（0-100）。
  aggressiveness Int @default(50)
  /// 外向性。社交性や外部へのエネルギー（0-100）。
  extroversion   Int @default(50)

  @@map("semiquantity_unchange_statuses")
}

/// Lv2: 不可逆的変化・定量可能。加齢や経験に伴う蓄積的な成長記録。
model QuantityIrreversibleStatus {
  id      String @id @default(uuid())
  /// ステータスの更新回数（版数）
  version Int    @default(1)

  /// NOTE: 1:N Relation (No @unique on FK)
  personaStatusId String        @map("persona_status_id")
  personaStatus   PersonaStatus @relation(fields: [personaStatusId], references: [statusId])

  /// 身長 (cm)。
  height             Float?
  /// 骨密度。加齢や健康状態の不可逆な指標。
  boneDensity        Float?    @map("bone_density")
  /// 最大筋力（握力）(kg)
  gripStrength       Float?    @map("grip_strength")
  /// 声の高さ（基本周波数）(Hz) 85-300
  voicePitch         Float?    @map("voice_pitch")
  /// 視力 0.1-2.0
  eyesight           Float?
  /// 聴力 (db) 0-70db
  hearingAbility     Float?    @map("hearing_ability")
  /// システム上の記録日時
  recordedAt         DateTime  @default(now()) @map("recorded_at")
  /// personaにとっての記録日時。過去の時間も入る。
  recordedForPersona DateTime? @map("recorded_for_persona")

  @@map("quantity_irreversible_statuses")
}

/// Lv3-1: 可変・定量可能。短中期的に変動する日常的なバイタルデータ。
// jsonで管理する
model QuantityReversibleStatus {
  id      String @id @default(uuid())
  version Int    @default(1)

  /// NOTE: 1:N Relation (No @unique on FK)
  personaStatusId String        @map("persona_status_id")
  personaStatus   PersonaStatus @relation(fields: [personaStatusId], references: [statusId])

  /// バイタルデータのJSON値。以下の形式のオブジェクトの配列として管理。
  /// 例: [
  ///   { "label": "weight", "value": 60.5, "unit": "kg" },
  ///   { "label": "body_temperature", "value": 36.5, "unit": "℃" }
  /// ]
  value Json

  /// 記録された日時
  recordedAt DateTime @default(now()) @map("recorded_at")

  @@map("quantity_reversible_statuses")
}

/// Lv3-2: 可変・定量困難。感情の揺れや対人関係の流動的なパラメータ。
// jsonで管理する
model SemiquantityReversibleStatus {
  id      String @id @default(uuid())
  version Int    @default(1)

  /// NOTE: 1:N Relation (No @unique on FK)
  personaStatusId String        @map("persona_status_id")
  personaStatus   PersonaStatus @relation(fields: [personaStatusId], references: [statusId])

  /// 感情・状態データのJSON値。以下の形式のオブジェクトの配列として管理。
  /// 例: [
  ///   { "label": "mood", "value": 80, "unit": null },
  ///   { "label": "trust", "value": 100, "unit": null }
  /// ]
  value Json

  /// 記録された日時
  recordedAt DateTime @default(now()) @map("recorded_at")

  @@map("semiquantity_reversible_statuses")
}

/// チャットセッション。ユーザーとペルソナの対話をまとめる単位。
model Chat {
  id        String    @id @default(uuid())
  /// セッションのタイトル
  title     String    @default("New Chat")
  /// 参加しているユーザー
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  /// 参加しているペルソナ
  personaId String
  persona   Persona   @relation(fields: [personaId], references: [id])
  /// セッション開始日時
  createdAt DateTime  @default(now())
  /// 最後に発言があった日時
  updatedAt DateTime  @updatedAt
  /// このセッションに紐づく個別の発言
  chatLogs  ChatLog[]

  @@map("chats")
}

/// 具体的な会話の一言。発言者と内容を記録。
model ChatLog {
  id        String   @id @default(uuid())
  /// 所属するチャットセッション
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id])
  /// 発言したユーザー
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  /// 対象となるペルソナ
  personaId String
  persona   Persona  @relation(fields: [personaId], references: [id])
  /// 発言の役割（"user" または "assistant"）
  role      String
  /// 発言内容。
  content   String   @db.Text
  /// 発言日時
  createdAt DateTime @default(now())

  @@map("chat_logs")
}

/// AIが行った「内省（自己分析）」の記録。
model ReflectionEvent {
  id        String   @id @default(uuid())
  /// 内省を行ったペルソナ
  personaId String
  persona   Persona  @relation(fields: [personaId], references: [id])
  /// 内省結果全体をJSONとして保存 (thought, statusUpdate, permanentMemory, newMemories 等を含む)
  response  Json
  /// 内省に使用されたシステムプロンプト
  prompt    String?  @db.Text
  /// 内省が行われた日時
  createdAt DateTime @default(now())

  @@map("reflection_events")
}

/// システム全体で発生したイベントの汎用的な記録。
model EventLog {
  id        String   @id @default(uuid())
  /// イベントの種別（"physical", "emotional", "memory" など）
  type      String
  /// イベントの詳細内容
  content   String   @db.Text
  /// 数値が伴う場合のデータ値（例：ダメージ量、回復量など）
  value     Float?
  /// 発生日時
  createdAt DateTime @default(now())

  @@map("event_logs")
}
