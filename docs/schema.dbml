
// Based on Normalized Database Proposal
// Reflecta Database Schema

Table users {
  id String [pk] // UUID
  name String
  email String [unique]
  created_at DateTime [default: `now()`]
}

Table personas {
  id String [pk] // UUID
  name String [default: 'Reflecta']
  status_id String [unique] // Link to current snapshot
  created_at DateTime [default: `now()`]
}

// Intermediate Hub Table / Snapshot
Table persona_statuses {
  status_id String [pk] // UUID
  created_at DateTime [default: `now()`]
  persona_id String [ref: > personas.id]
}

// -----------------------------------------------------------------------------
// Lv1-1: QuantityUnchange (Biological/Genetic info)
// -----------------------------------------------------------------------------
Table quantity_unchange_items {
  id String [pk]
  name String [unique, note: "e.g. 'birth_date', 'gender'"]
  label String [note: "Display name"]
  data_type String [note: "'date', 'string', 'int', 'float'"]
}

Table quantity_unchange_values {
  id String [pk]
  persona_status_id String [ref: > persona_statuses.status_id]
  item_id String [ref: > quantity_unchange_items.id]
  
  // Typed value columns
  val_date DateTime
  val_string String
  val_int Int
  val_float Float
  
  indexes {
    (persona_status_id, item_id) [unique]
  }
}

// -----------------------------------------------------------------------------
// Lv1-2: SemiquantityUnchange (Deep psychological traits)
// -----------------------------------------------------------------------------
Table semiquantity_unchange_items {
  id String [pk]
  name String [unique, note: "e.g. 'ethics', 'passion'"]
  label String
  data_type String
}

Table semiquantity_unchange_values {
  id String [pk]
  persona_status_id String [ref: > persona_statuses.status_id]
  item_id String [ref: > semiquantity_unchange_items.id]
  
  val_int Int [default: 50]
  // Other types reserved for future use
  val_string String
  val_float Float
  
  indexes {
    (persona_status_id, item_id) [unique]
  }
}

// -----------------------------------------------------------------------------
// Lv2: QuantityIrreversible (Cumulative growth)
// -----------------------------------------------------------------------------
Table quantity_irreversible_items {
  id String [pk]
  name String [unique, note: "e.g. 'height', 'bone_density'"]
  label String
  data_type String
}

Table quantity_irreversible_values {
  id String [pk]
  persona_status_id String [ref: > persona_statuses.status_id]
  item_id String [ref: > quantity_irreversible_items.id]
  version Int [default: 1]
  
  val_float Float
  val_int Int
  val_string String
  
  recorded_at DateTime [default: `now()`]
  
  indexes {
    (persona_status_id, item_id) [unique]
  }
}

// -----------------------------------------------------------------------------
// Lv3-1: QuantityReversible (Daily vitals)
// -----------------------------------------------------------------------------
Table quantity_reversible_items {
  id String [pk]
  name String [unique, note: "e.g. 'weight', 'blood_sugar'"]
  label String
  data_type String
}

Table quantity_reversible_values {
  id String [pk]
  persona_status_id String [ref: > persona_statuses.status_id]
  item_id String [ref: > quantity_reversible_items.id]
  version Int [default: 1]
  
  val_float Float
  val_int Int
  val_string String
  
  recorded_at DateTime [default: `now()`]
  
  indexes {
    (persona_status_id, item_id) [unique]
  }
}

// -----------------------------------------------------------------------------
// Lv3-2: SemiquantityReversible (Mood and dynamic traits)
// -----------------------------------------------------------------------------
Table semiquantity_reversible_items {
  id String [pk]
  name String [unique, note: "e.g. 'mood', 'trust', 'health'"]
  label String
  data_type String
}

Table semiquantity_reversible_values {
  id String [pk]
  persona_status_id String [ref: > persona_statuses.status_id]
  item_id String [ref: > semiquantity_reversible_items.id]
  version Int [default: 1]
  
  val_int Int [default: 50]
  val_string String
  
  updated_at DateTime [default: `now()`]
  
  indexes {
    (persona_status_id, item_id) [unique]
  }
}

// -----------------------------------------------------------------------------
// Chat & Events
// -----------------------------------------------------------------------------
Table chats {
  id String [pk]
  title String [default: 'New Chat']
  user_id String [ref: > users.id]
  persona_id String [ref: > personas.id]
  created_at DateTime [default: `now()`]
  updated_at DateTime
}

Table chat_logs {
  id String [pk]
  chat_id String [ref: > chats.id]
  user_id String [ref: > users.id]
  persona_id String [ref: > personas.id]
  role String
  content String
  created_at DateTime [default: `now()`]
}

Table reflection_events {
  id String [pk]
  persona_id String [ref: > personas.id]
  thought String
  status_update Json
  prompt String
  permanent_memory String
  created_at DateTime [default: `now()`]
}

Table event_logs {
  id String [pk]
  type String
  content String
  value Float
  created_at DateTime [default: `now()`]
}

// Relations for Persona / Status are handled by Ref comments or inline [ref: > ...] 
// Note: Inline ref syntax is preferred in DBML 2.0 but standard `Ref:` at bottom also works.
// Specific relationships to Status Hub:

Ref: personas.status_id - persona_statuses.status_id
