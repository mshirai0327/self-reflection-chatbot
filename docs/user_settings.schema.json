{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Reversible Status Value Schema",
    "description": "Schema for the JSON 'value' column in QuantityReversibleStatus and SemiquantityReversibleStatus tables.",
    "type": "array",
    "items": {
        "type": "object",
        "required": [
            "label",
            "value"
        ],
        "properties": {
            "label": {
                "type": "string",
                "description": "The identifier key for the status parameter (e.g., 'weight', 'mood')."
            },
            "value": {
                "type": "number",
                "description": "The numerical value of the status."
            },
            "unit": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Unit of measurement (e.g., 'kg', 'mmHg'). Null for abstract values."
            }
        }
    },
    "examples": [
        {
            "description": "QuantityReversibleStatus Example (Vital Data)",
            "data": [
                {
                    "label": "weight",
                    "value": 60.5,
                    "unit": "kg"
                },
                {
                    "label": "body_fat_percentage",
                    "value": 22.0,
                    "unit": "%"
                },
                {
                    "label": "body_temperature",
                    "value": 36.5,
                    "unit": "℃"
                },
                {
                    "label": "blood_sugar",
                    "value": 95,
                    "unit": "mg/dL"
                },
                {
                    "label": "blood_pressure_sys",
                    "value": 110,
                    "unit": "mmHg"
                },
                {
                    "label": "blood_pressure_dia",
                    "value": 70,
                    "unit": "mmHg"
                },
                {
                    "label": "sleep_time",
                    "value": 7.5,
                    "unit": "h"
                },
                {
                    "label": "sleep_quality",
                    "value": 8,
                    "unit": null
                }
            ]
        },
        {
            "description": "SemiquantityReversibleStatus Example (Mood/Health)",
            "data": [
                {
                    "label": "health",
                    "value": 90,
                    "unit": null
                },
                {
                    "label": "mood",
                    "value": 85,
                    "unit": null
                },
                {
                    "label": "trust",
                    "value": 100,
                    "unit": null
                },
                {
                    "label": "friendliness",
                    "value": 60,
                    "unit": null
                }
            ]
        }
    ]
}