# =============================================
# Reflecta 環境変数テンプレート
# このファイルを .env.development / .env.production にコピーして使用してください
# =============================================

# --- 環境識別 ---
# "development" または "production"
NODE_ENV="development"

# --- Database Configuration ---
# Prismaで利用するデータベースの接続URL
DATABASE_URL="mysql://user:password@localhost:3306/ai_reflection_db"


# --- LLM Provider Configuration (LangChain) ---
# 使用するLLMのプロバイダを選択します ("gemini" または "openai")
# デフォルトは "gemini" です。
# "openai" を選択した場合、下の OPENAI_API_KEY や OPENAI_BASE_URL が利用されます。
LLM_PROVIDER="gemini"


# --- API Keys ---
# Google Gemini APIを利用する場合のAPIキー
GOOGLE_GENERATIVE_AI_API_KEY=""

# OpenAI API や、OllamaなどのOpenAI互換APIを利用する場合のAPIキー
# (必須ではない。互換APIがキーを要求しない場合は空で良い)
OPENAI_API_KEY=""


# --- Endpoints ---
# ローカルLLM（Ollama, LM Studioなど）のOpenAI互換エンドポイントを指定します
# 例: "http://localhost:11434/v1"
# このURLは、`llm.ts` の `ChatOpenAI` インスタンスの `baseURL` として利用されます。
OPENAI_BASE_URL=""


# --- ChromaDB ---
# ChromaDBの接続URL
CHROMA_URL="http://localhost:8000"


# --- CORS ---
# 許可するオリジン（カンマ区切り）
# 開発: "http://localhost:5173,http://localhost:3000"
# 本番: "https://your-production-domain.com"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"


# --- Docker判定 ---
# Docker内で動作しているかどうか（ホスト名解決に使用）
IS_DOCKER="false"


# --- セキュリティ ---
# Local LLM プロキシAPI（/api/llm/models, /api/llm/test）の有効化
# 本番環境では "false" にしてください（SSRF対策）
ENABLE_LOCAL_LLM_PROXY="true"
