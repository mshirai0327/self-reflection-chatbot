# ===========================================
# Reflecta LLM Service - 環境変数設定
# ===========================================
# このファイルをコピーして .env を作成してください。
# Docker環境では docker-compose.yml から環境変数が注入されるため、
# ローカル開発時のみこのファイルが使用されます。

# --- Google AI API ---
# Google AI Studio で取得した API キー
GOOGLE_API_KEY="YOUR_GOOGLE_API_KEY_HERE"

# 埋め込みモデル名（backend/.env の GOOGLE_EMBEDDING_MODEL と統一してください）
GOOGLE_EMBEDDING_MODEL="gemini-embedding-001"

# --- Neo4j ---
# ナレッジグラフ用データベース接続設定
NEO4J_URI="bolt://neo4j:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your_neo4j_password_here"

# --- 知識抽出用LLM ---
# ナレッジグラフへの知識抽出に使用するモデル設定
# デフォルトは Gemini Pro。Local LLM を使う場合は以下を変更してください。
EXTRACTION_LLM_PROVIDER="gemini"
EXTRACTION_LLM_MODEL="gemini-2.5-pro"
# EXTRACTION_LLM_ENDPOINT="http://host.docker.internal:1234/v1"

# --- OpenAI互換 API (Local LLM用、任意) ---
# LM Studio や Ollama など OpenAI互換エンドポイントを使用する場合に設定
# OPENAI_API_KEY="no-key-required"
