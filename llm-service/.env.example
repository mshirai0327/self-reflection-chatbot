# ===========================================
# Reflecta LLM Service - 環境変数設定
# ===========================================
# このファイルをコピーして .env を作成してください。
# Docker環境では docker-compose.yml から環境変数が注入されるため、
# ローカル開発時のみこのファイルが使用されます。

# --- Google AI API ---
# Google AI Studio で取得した API キー
GOOGLE_API_KEY="YOUR_GOOGLE_API_KEY_HERE"

# 埋め込みモデル名（backend/.env の GOOGLE_EMBEDDING_MODEL と統一してください）
GOOGLE_EMBEDDING_MODEL="gemini-embedding-001"

# --- Neo4j ---
# ナレッジグラフ用データベース接続設定
NEO4J_URI="bolt://neo4j:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"

# --- OpenAI互換 API (Local LLM用、任意) ---
# LM Studio や Ollama など OpenAI互換エンドポイントを使用する場合に設定
# OPENAI_API_KEY="no-key-required"
